name: solar-check

on:
  schedule:
    - cron: "*/5 5-15 * * *"   # UTC; покрива дневните часове в България
  workflow_dispatch:
    inputs:
      discover:
        description: "Прати всички стойности от инвертора в ntfy (true/false)"
        default: "false"

permissions:
  contents: read

concurrency:
  group: solar-check
  cancel-in-progress: false

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - run: pip install requests

      - name: Restore state
        uses: actions/cache/restore@v4
        with:
          path: state.json
          key: state-none
          restore-keys: state-

      - name: Check inverter
        run: python solar_check.py
        env:
          SOLARMAN_APP_ID: ${{ secrets.SOLARMAN_APP_ID }}
          SOLARMAN_APP_SECRET: ${{ secrets.SOLARMAN_APP_SECRET }}
          SOLARMAN_EMAIL: ${{ secrets.SOLARMAN_EMAIL }}
          SOLARMAN_PASSWORD: ${{ secrets.SOLARMAN_PASSWORD }}
          INVERTER_SN: ${{ secrets.INVERTER_SN }}
          NTFY_TOPIC: ${{ secrets.NTFY_TOPIC }}
          DISCOVER: ${{ github.event.inputs.discover || 'false' }}

      - name: Save state
        if: always()
        uses: actions/cache/save@v4
        with:
          path: state.json
          key: state-${{ github.run_id }}-${{ github.run_attempt }}
